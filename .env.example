# ---------------------------------------------------------------------------
# EC2 / Docker Compose .env — never commit real secrets
# ---------------------------------------------------------------------------

# --- Required for Email OTP + Forgot Password ---
MAIL_USERNAME=care.nirvaankar@gmail.com
# Gmail App Password: 16 chars, NO SPACES
MAIL_APP_PASSWORD=your16charapppassword
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# --- Required for SMS OTP (Fast2SMS Quick SMS, route=q) ---
FAST2SMS_API_KEY=
# Optional override (default https://fast2sms.com → posts to /dev/bulkV2)
# FAST2SMS_API_URL=https://fast2sms.com

# Public frontend hosts used inside password-reset emails (NOT the API :8080)
CUSTOMER_FRONTEND_BASE_URL=http://nirvaankar.s3-website.ap-south-1.amazonaws.com
SELLER_FRONTEND_BASE_URL=http://nirvaankar.s3-website.ap-south-1.amazonaws.com/seller

# --- Already needed by compose (keep your existing values) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nirvaankar
MYSQL_USER=
MYSQL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
NIRVAANKAR_S3_BUCKET=nirvaankar

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Seller KYC verification ---
# GST: gstinapi.in (GET /v1/gstin/{GSTIN}, header x-api-key)
GST_VERIFICATION_API_KEY=
GST_VERIFICATION_BASE_URL=https://www.gstinapi.in/v1
# BANK: Cashfree-like Reverse Penny Drop (optional until signed up)
BANK_VERIFICATION_API_KEY=
BANK_VERIFICATION_BASE_URL=https://api.example-bank-provider.com/v1
# Base64 of 32 random bytes — required to store bank account numbers encrypted
# Generate: openssl rand -base64 32
NIRVAANKAR_DATA_ENCRYPTION_KEY=HmKrcz6KlKPKhThPOkFfmNyOQE+FaUDcNtqyWrt01s4=

# Optional JWT (recommended in prod)
# NIRVAANKAR_JWT_PRIVATE_KEY=
# NIRVAANKAR_JWT_PUBLIC_KEY=
