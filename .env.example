# --- Required for Email OTP + Forgot Password ---
MAIL_USERNAME=care.nirvaankar@gmail.com
# Gmail App Password: 16 chars, NO SPACES
MAIL_APP_PASSWORD=your16charapppassword
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# Public frontend hosts used inside password-reset emails (NOT the API :8080)
CUSTOMER_FRONTEND_BASE_URL=http://nirvaankar.s3-website.ap-south-1.amazonaws.com
SELLER_FRONTEND_BASE_URL=http://nirvaankar.s3-website.ap-south-1.amazonaws.com/seller

# --- Already needed by compose (keep your existing values) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nirvaankar
MYSQL_USER=
MYSQL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
NIRVAANKAR_S3_BUCKET=nirvaankar

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
