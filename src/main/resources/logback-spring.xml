<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Masks secrets before they ever reach a log file. -->
    <conversionRule conversionWord="mask"
                    class="com.nirvaankar.marketplace.common.util.SecretMaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %-5level [%X{traceId:-}] [%thread] %logger{36} - %mask%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
